diff --git a/public/404.html b/public/404.html
new file mode 100644
index 0000000..ca23625
--- /dev/null
+++ b/public/404.html
@@ -0,0 +1,30 @@
+<!DOCTYPE html>
+<html lang="es-MX">
+  <head>
+    <meta charset="UTF-8" />
+    <title>Poketiempo MX</title>
+    <script type="text/javascript">
+      // Truco estandar para SPAs en GitHub Pages (github.com/rafgraph/spa-github-pages).
+      // GitHub Pages no reescribe rutas de client-side routing: cuando alguien entra
+      // directo a /PokeTiempo-MX/test o refresca esa URL, sirve este 404.html.
+      // Aqui codificamos la ruta real en un querystring y redirigimos a index.html,
+      // que la decodifica (ver script en index.html) y restaura la URL con
+      // history.replaceState sin volver a recargar.
+      //
+      // pathSegmentsToKeep = 1 porque el sitio vive bajo /PokeTiempo-MX/ (un segmento).
+      // Si se muda a un dominio propio en raiz, cambiar a 0 (o borrar este archivo
+      // junto con el script de index.html, ya que en raiz no hace falta).
+      var pathSegmentsToKeep = 1
+
+      var l = window.location
+      l.replace(
+        l.protocol + '//' + l.hostname + (l.port ? ':' + l.port : '') +
+        l.pathname.split('/').slice(0, 1 + pathSegmentsToKeep).join('/') + '/?/' +
+        l.pathname.slice(1).split('/').slice(pathSegmentsToKeep).join('/').replace(/&/g, '~and~') +
+        (l.search ? '&' + l.search.slice(1).replace(/&/g, '~and~') : '') +
+        l.hash
+      )
+    </script>
+  </head>
+  <body></body>
+</html>
