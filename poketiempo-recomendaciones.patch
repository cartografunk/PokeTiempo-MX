diff --git a/src/hooks/usePageTitle.ts b/src/hooks/usePageTitle.ts
new file mode 100644
index 0000000..4217def
--- /dev/null
+++ b/src/hooks/usePageTitle.ts
@@ -0,0 +1,14 @@
+import { useEffect } from 'react'
+
+/**
+ * Actualiza document.title por pagina. Sin dependencias extra (react-helmet
+ * no es necesario para algo tan simple en una SPA sin SSR).
+ * Pasar el titulo completo, ej: 'Media kit | Poketiempo MX'.
+ */
+function usePageTitle(title: string) {
+  useEffect(() => {
+    document.title = title
+  }, [title])
+}
+
+export default usePageTitle
diff --git a/src/hooks/useScrollToHash.ts b/src/hooks/useScrollToHash.ts
new file mode 100644
index 0000000..31a93c9
--- /dev/null
+++ b/src/hooks/useScrollToHash.ts
@@ -0,0 +1,31 @@
+import { useEffect } from 'react'
+import { useLocation } from 'react-router-dom'
+
+/**
+ * Al navegar a una ruta con hash (ej. /media-kit#colaboraciones), hace scroll
+ * al elemento correspondiente. React Router no hace esto automaticamente en
+ * navegacion client-side (a diferencia de un <a href="#ancla"> nativo).
+ */
+function useScrollToHash() {
+  const { hash, pathname } = useLocation()
+
+  useEffect(() => {
+    if (!hash) {
+      window.scrollTo({ top: 0 })
+      return
+    }
+
+    const id = hash.replace('#', '')
+    // Se espera un tick a que el DOM de la nueva pagina este montado.
+    const timer = window.setTimeout(() => {
+      const el = document.getElementById(id)
+      if (el) {
+        el.scrollIntoView({ behavior: 'smooth', block: 'start' })
+      }
+    }, 0)
+
+    return () => window.clearTimeout(timer)
+  }, [hash, pathname])
+}
+
+export default useScrollToHash
